; Engine configuration file.
; Godot 4.6 project rebuilt from the browser version of TIME ECHO.
config_version=5

[application]

config/name="TIME ECHO"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
DataManager="*res://scripts/autoload/data_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
InventoryManager="*res://scripts/autoload/inventory_manager.gd"
KnowledgeManager="*res://scripts/autoload/knowledge_manager.gd"
TimeManager="*res://scripts/autoload/time_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"keycode":4194320)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"keycode":4194322)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"keycode":4194319)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"keycode":4194321)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"keycode":32)]
}
cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305)]
}
journal={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":74)]
}
inventory={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":73), Object(InputEventKey,"physical_keycode":66)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":80)]
}
run={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.039, 0.071, 0.075, 1)

